__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Run outputs: checkpoints, merged weights, reports, manifests.
# Regenerate with `ftspec train` / `ftspec eval`; never commit weights.
outputs/
*.bin
*.safetensors
*.pt
wandb/

# NOTE: data/*.jsonl IS committed on purpose. It is a deliverable of the PoC and
# CI asserts it matches what the committed seed regenerates, so the benchmark
# stays reproducible from source.

.DS_Store
.idea/
.vscode/

# Local-only working material, not part of the engine.
sales/

# ftplatform per-customer state: raw customer data, model weights, and the
# sqlite pointer store. Never shared, never committed. Anchored to the repo
# root (leading /) so it doesn't also match the ftplatform/customers/ package.
/customers.db
/customers/

# Local staging for ftplatform.remote (Kaggle job packets/output) -- same
# sensitivity as /customers/ above, since a packet carries one customer's
# data.
/.kaggle_work/
